{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.huanglawfl.com" }],
      "destination": "https://huanglawfl.com/:path*",
      "permanent": true
    },
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/about", "destination": "/#about", "permanent": true },
    { "source": "/practice-areas", "destination": "/#practice", "permanent": true },
    { "source": "/contact", "destination": "/#contact", "permanent": true },
    { "source": "/privacy", "destination": "/privacy.html", "permanent": true },
    { "source": "/privacy-policy", "destination": "/privacy.html", "permanent": true },
    { "source": "/terms", "destination": "/terms.html", "permanent": true },
    { "source": "/terms-of-use", "destination": "/terms.html", "permanent": true },
    { "source": "/disclaimer", "destination": "/terms.html", "permanent": true },
    { "source": "/florida-creditor-rights-lawyer", "destination": "/creditor-representation.html", "permanent": true },
    { "source": "/florida-bankruptcy-attorney", "destination": "/creditor-representation.html", "permanent": true },
    { "source": "/florida-business-litigation-attorney", "destination": "/", "permanent": true },
    { "source": "/florida-banking-law-attorney", "destination": "/", "permanent": true },
    { "source": "/florida-probate-litigation-lawyer", "destination": "/", "permanent": true },
    { "source": "/florida-immigration-lawyer", "destination": "/", "permanent": true },
    { "source": "/florida-certified-mediator", "destination": "/#about", "permanent": true },
    { "source": "/florida-local-counsel", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
